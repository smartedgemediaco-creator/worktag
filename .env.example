# WorkTag environment template
# Copy to .env.local and fill in. Every provider below is swappable at runtime —
# change the *PROVIDER var and the credentials, nothing else.
#
# Per-environment templates also exist (gitignored after copy):
#   cp .env.development.example .env.local   # local dev
#   cp .env.staging.example    .env.staging   # staging host / deploy
#   cp .env.production.example .env.production # production host / deploy

# --- App ---
# development | staging | production. Derives from NODE_ENV or VERCEL_ENV if unset.
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Comma-separated https image hosts allowed by next/image. Empty = built-in defaults.
NEXT_PUBLIC_IMAGE_HOSTS=

# --- Database (Prisma + Neon Postgres) ---
# Connection string with ?sslmode=require; use the pooled (PgBouncer) host for prod.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/worktag?sslmode=require
# Non-pooled (direct) connection used by `prisma migrate`. Pooled only otherwise.
# DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/worktag?sslmode=require

# --- Auth (better-auth) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Payments (port: src/infra/providers/payment) ---
# Choose ONE provider. Change the value + keys to swap providers.
# REQUIRED in staging/production — the app fails fast if left unset.
PAYMENT_PROVIDER=paystack            # paystack | flutterwave
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx

# --- Email (port: src/infra/providers/email) ---
# console logs in dev; resend sends real mail. Swap by changing the value.
# REQUIRED in staging/production.
EMAIL_PROVIDER=console               # console | resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# RESEND_FROM=no-reply@yourdomain.com

# --- SMS (port: src/infra/providers/sms) ---
# REQUIRED in staging/production.
SMS_PROVIDER=console                 # console | termii | twilio
# SMS_PROVIDER=termii
# TERMII_API_KEY=xxx
# TERMII_SENDER_ID=WorkTag
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM_NUMBER=+15551234567

# --- Storage (port: src/infra/providers/storage) ---
# local writes to ./public/uploads (dev). s3 works with ANY S3-compatible bucket:
# Cloudflare R2, Neon Object Storage, AWS S3, MinIO, Backblaze — same adapter.
# REQUIRED in staging/production.
STORAGE_PROVIDER=local                # local | s3
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=xxx
# STORAGE_SECRET_ACCESS_KEY=xxx
# STORAGE_BUCKET_NAME=worktag
# STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
# STORAGE_REGION=auto
