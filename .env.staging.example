# WorkTag STAGING template
# Copy to .env.staging:  cp .env.staging.example .env.staging
# Staging behaves exactly like production: every provider MUST be declared
# explicitly or the app refuses to boot (fail fast — no silent console/local).
# Use test keys, a Neon branch (not prod), and a separate R2 bucket.

APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
BETTER_AUTH_URL=https://staging.yourdomain.com
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Neon branch created from main with pgBouncer pooling enabled.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/worktag-staging?sslmode=require
# Non-pooled (direct) connection used by `prisma migrate`.
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/worktag-staging?sslmode=require

# NEXT_PUBLIC_IMAGE_HOSTS=cdn.yourdomain.com

# --- Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Payments: pick ONE ---
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-test-xxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-test-xxx

# --- Email ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_test_xxx
RESEND_FROM=no-reply@staging.yourdomain.com

# --- SMS: pick ONE ---
SMS_PROVIDER=termii
TERMII_API_KEY=xxx
TERMII_SENDER_ID=WorkTag
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM_NUMBER=+15551234567

# --- Storage: S3-compatible (R2/Neon/AWS/MinIO) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=xxx
STORAGE_SECRET_ACCESS_KEY=xxx
STORAGE_BUCKET_NAME=worktag-staging
STORAGE_PUBLIC_URL=https://cdn-staging.yourdomain.com
STORAGE_REGION=auto
