# WorkTag LOCAL DEVELOPMENT template
# Copy to .env.local:  cp .env.development.example .env.local
# Provider defaults kick in automatically: console email/SMS, local storage,
# Paystack payments. Everything below is optional in development.

APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
DATABASE_URL=postgresql://user:password@localhost:5432/worktag

# NEXT_PUBLIC_IMAGE_HOSTS=

# --- Payments (optional in dev) ---
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-test-xxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-test-xxx

# --- Email (optional in dev; console logs by default) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# RESEND_FROM=no-reply@yourdomain.com

# --- SMS (optional in dev; console logs by default) ---
# SMS_PROVIDER=termii
# TERMII_API_KEY=xxx
# TERMII_SENDER_ID=WorkTag

# --- Storage (optional in dev; local ./public/uploads by default) ---
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=xxx
# STORAGE_SECRET_ACCESS_KEY=xxx
# STORAGE_BUCKET_NAME=worktag
# STORAGE_PUBLIC_URL=http://localhost:3000
# STORAGE_REGION=auto
