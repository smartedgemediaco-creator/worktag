# WorkTag PRODUCTION template
# Copy to .env.production on the production host / CI secret store.
# Every provider MUST be declared explicitly or the app refuses to boot.
# Use live keys and the production Neon database + production R2 bucket.

APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.worktag.app
BETTER_AUTH_URL=https://app.worktag.app
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Production Neon database with pgBouncer pooling.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/worktag?sslmode=require
# Non-pooled (direct) connection used by `prisma migrate`.
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/worktag?sslmode=require

# NEXT_PUBLIC_IMAGE_HOSTS=cdn.worktag.app

# --- Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Payments: pick ONE ---
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx

# --- Email ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_live_xxx
RESEND_FROM=no-reply@worktag.app

# --- SMS: pick ONE ---
SMS_PROVIDER=termii
TERMII_API_KEY=xxx
TERMII_SENDER_ID=WorkTag
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM_NUMBER=+15551234567

# --- Storage: S3-compatible (R2/Neon/AWS/MinIO) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=xxx
STORAGE_SECRET_ACCESS_KEY=xxx
STORAGE_BUCKET_NAME=worktag
STORAGE_PUBLIC_URL=https://cdn.worktag.app
STORAGE_REGION=auto
